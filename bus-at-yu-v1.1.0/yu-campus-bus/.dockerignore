# 이미지에 넣지 않을 것들.
# serveStatic 이 허용목록으로 막고 있지만, 애초에 이미지에 안 넣는 게 더 안전하다.
node_modules
artifacts
*.zip
.git
.gitignore

# 개발·검수 도구 (운영에서 실행하지 않음)
scripts/
tests/
admin.html
stop-editor.*
path-editor.*

# 문서 (컨테이너에 있을 이유가 없음)
*.md

# 손그림 원본 이미지 1.26MB — 앱에서 참조하지 않음
route-guide-r1.png
route-guide-r2.png

# 비밀값
.env
.env.*
